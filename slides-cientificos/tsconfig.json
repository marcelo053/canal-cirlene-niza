{
  "compilerOptions": {
    "target": "ES2020",
    "lib": ["ES2020", "DOM"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "outDir": "dist",
    "ignoreDeprecations": "5.0",
    "skipLibCheck": true
  },
  "include": ["src/**/*", "remotion.config.ts"]
}
